{
  "name": "torchviz-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.11"
    },
    "use-resize-observer": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "build": "vite build",
    "verify": "npm run typecheck && npm test && npm run build",
    "sync:titles": "node --experimental-strip-types scripts/syncMdxTitles.ts",
    "audit:cl-citation-evidence": "node --experimental-strip-types scripts/auditContinualLearningCitationEvidence.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mafs": "0.21.0",
    "monaco-editor": "^0.56.0",
    "pyodide": "0.25.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.0",
    "shiki": "^4.4.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.15",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}

# Cloudflare R2 Credentials & Asset Sync Configuration
#
# Obtain these credentials from your Cloudflare Dashboard:
# 1. Account ID: Cloudflare Dashboard > Overview (right sidebar) or R2 Overview
# 2. Access Keys: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token (Permissions: Object Read & Write)
# 3. Bucket Name: The name of the R2 bucket you created (e.g. torchviz-assets)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=torchviz-assets

# Public domain or r2.dev subdomain for serving assets
# Example: https://assets.yourdomain.com or https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=https://assets.yourdomain.com

# Client-side CDN Base URL injected at build time by vite.config.ts
#
# --- Vercel / CI production ---
# Set this key in the Vercel Dashboard → Settings → Environment Variables:
#   Key:   ASSETS_CDN_URL
#   Value: https://pub-xxxxxxxxxxxx.r2.dev  (or your custom domain)
# Vercel exposes it as process.env.ASSETS_CDN_URL during the build step.
ASSETS_CDN_URL=
#
# --- Local development (.env file only) ---
# When running `npm run dev` locally you can still use the VITE_ prefix,
# which Vite reads from this .env file and passes to vite.config.ts.
# Leave ASSETS_CDN_URL blank below; set VITE_ASSETS_CDN_URL instead.
VITE_ASSETS_CDN_URL=
